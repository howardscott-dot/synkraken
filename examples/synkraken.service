[Unit]
Description=SynKraken local bridge daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Example only: replace both paths if you install this unit manually.
WorkingDirectory=/absolute/path/to/synkraken
ExecStart=/absolute/path/to/synkraken-daemon --config /absolute/path/to/synkraken/config.local.json
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
