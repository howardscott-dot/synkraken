{
  "server": {
    "host": "127.0.0.1",
    "port": 9460
  },
  "storage": {
    "sqlite_path": "./data/synkraken.db"
  },
  "instance": {
    "instance_name": "",
    "organisation_name": "",
    "default_workspace": ""
  },
  "routing": {
    "max_hops": 4,
    "default_timeout_seconds": 90,
    "retry_limit": 1,
    "retry_backoff_seconds": 1
  },
  "memory": {
    "max_items_injected": 5,
    "max_chars_injected": 1200,
    "max_memory_chars": 500,
    "min_confidence": 70
  },
  "goal": {
    "max_rounds": 3,
    "threshold": 80,
    "max_reviewers": 3,
    "max_context_chars": 4000,
    "max_revision_chars": 1500,
    "max_agents": 4
  },
  "adapters": {
    "goose": {
      "type": "goose",
      "enabled": true,
      "command": ["goose"],
      "timeout_seconds": 90,
      "system": "You are replying through synkraken. Keep replies concise and structured."
    },
    "hermes": {
      "type": "hermes",
      "enabled": true,
      "command": ["hermes"],
      "timeout_seconds": 120,
      "system_prefix": "You are replying through synkraken. Keep replies concise and structured."
    },
    "openclaw-main": {
      "type": "openclaw",
      "enabled": true,
      "command": ["openclaw"],
      "timeout_seconds": 120,
      "agent_id": "main",
      "message_prefix": "You are receiving this via synkraken. Reply directly and concisely."
    },
    "claude": {
      "type": "claude",
      "enabled": true,
      "command": ["claude"],
      "timeout_seconds": 120,
      "_comment_bare": "Set bare:true only if ANTHROPIC_API_KEY is set in the daemon env. Bare mode disables OAuth and keychain reads.",
      "bare": false,
      "permission_mode": "bypassPermissions",
      "output_format": "text",
      "message_prefix": "Keep replies focused and structured."
    },
    "odysseus": {
      "_comment": "Experimental optional adapter. Odysseus must be installed, running separately, token-authenticated, and already configured with its internal model endpoint. SynKraken does not install skills, MCP, tasks, or webhooks into Odysseus yet.",
      "type": "odysseus",
      "enabled": false,
      "base_url": "http://127.0.0.1:7000",
      "token_env": "ODYSSEUS_TOKEN",
      "model": "mistral-small:latest",
      "timeout_seconds": 120
    }
  }
}
