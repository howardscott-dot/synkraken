{
  "note": "Example showing explicit local command paths for machines that do not have goose, hermes, or openclaw in PATH.",
  "server": {
    "host": "127.0.0.1",
    "port": 9460
  },
  "storage": {
    "sqlite_path": "./data/synkraken.db"
  },
  "instance": {
    "instance_name": "",
    "organisation_name": "",
    "default_workspace": ""
  },
  "routing": {
    "max_hops": 4,
    "default_timeout_seconds": 90,
    "retry_limit": 1,
    "retry_backoff_seconds": 1
  },
  "memory": {
    "max_items_injected": 5,
    "max_chars_injected": 1200,
    "max_memory_chars": 500,
    "min_confidence": 70
  },
  "goal": {
    "max_rounds": 3,
    "threshold": 80,
    "max_reviewers": 3,
    "max_context_chars": 4000,
    "max_revision_chars": 1500,
    "max_agents": 4
  },
  "adapters": {
    "goose": {
      "type": "goose",
      "enabled": true,
      "command": ["/absolute/path/to/goose"],
      "timeout_seconds": 90
    },
    "hermes": {
      "type": "hermes",
      "enabled": true,
      "command": ["/absolute/path/to/hermes"],
      "timeout_seconds": 120
    },
    "openclaw-main": {
      "type": "openclaw",
      "enabled": true,
      "command": ["/absolute/path/to/openclaw"],
      "timeout_seconds": 120,
      "agent_id": "main",
      "experimental": true
    }
  }
}
